<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the app inspect Wi-Fi state and platform capability without scanning. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Paired with fine location for Android 12+ permission UX; fine is still required for scans. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Required by Android scan-result APIs for future nearby Wi-Fi discovery. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Required to request foreground Wi-Fi scans with WifiManager.startScan(). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Yeyecatl can still open and explain unsupported state on devices without Wi-Fi. -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yeyecatl">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Yeyecatl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
